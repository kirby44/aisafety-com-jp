# Taiwan: configure a separate Vercel project against the SAME Git repo.
# MAP_COUNTRY=tw
# AIRTABLE_TOKEN=<token with read access to the Taiwan base>
# AIRTABLE_BASE_ID=<Taiwan base ID>
# AIRTABLE_TABLE_ID=<Taiwan Orgs table ID>
# AIRTABLE_VIEW_ID=<Taiwan view ID, or leave empty for all records>
# SITE_URL=https://<Taiwan project's actual domain>
# MAP_RAW_DATA_URL=<Taiwan public read-only share URL, or leave empty to hide>

# Optional branding overrides (both deployments use the existing English UI):
# SITE_TITLE=Taiwan AI Safety Map
# MAP_TITLE=Map of AI Existential Safety in Taiwan
# SITE_DESCRIPTION=Explore Taiwan's AI safety ecosystem.
# MAP_NOTICE=Draft map — initial entries are provisional and awaiting local review.
# Set MAP_NOTICE to an empty string when the Taiwan draft has been reviewed.
# The submission link comes from the "Suggest entry" row in each Airtable base.
